.vscode/**
.vscode-test/**
src/**
test/**

# Compiled tests. Never loaded by the extension, and shipping them put
# credential-shaped fixtures from the redaction tests into the VSIX — which
# vsce's secret scanner (correctly) refuses to package. Releases up to and
# including 1.2.1 shipped out/test/ unnoticed, because the tests of the day
# had no secret-shaped strings in them.
out/test/**

.gitignore
.yarnrc
vsc-extension-quickstart.md
esbuild.js
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
# 15 MB demo video: referenced from the GitHub repo, never by the packaged
# extension or the marketplace readme. No reason to ship it to every user.
assets/DebugMCP.mp4

# NOTE: node_modules is deliberately NOT excluded. The extension ships as
# unbundled out/*.js, so it still resolves express, the MCP SDK, zod and
# serialport from the installed tree at runtime. Excluding node_modules only
# becomes correct once the esbuild bundle in esbuild.js is switched on — see
# docs/packaging-esbuild.md for the allow-list that has to go with it.
